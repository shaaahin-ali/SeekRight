# Copy this to .env for local development
# Your Mistral AI API key (get one free at https://console.mistral.ai)
MISTRAL_API_KEY=your_mistral_api_key_here

# Comma-separated allowed frontend origins (add your Vercel URL here in production)
# Example: FRONTEND_URL=https://seekright.vercel.app
FRONTEND_URL=http://localhost:5173
